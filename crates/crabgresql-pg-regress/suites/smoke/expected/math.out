--
-- MATH
-- The radian trigonometric tier (sin/cos/tan/cot, asin/acos/atan/atan2), the
-- angle conversions pi()/degrees()/radians(), and gcd()/lcm() over int4, int8
-- and numeric. Output generated by running this file through psql -a -q
-- against PostgreSQL, then compared byte-for-byte.
--
-- extra_float_digits = 3 is the shortest-exact float8 output, so a last-bit
-- divergence in any of these shows up here rather than hiding behind rounding.
SET extra_float_digits = 3;
--
-- pi() and the angle conversions
--
SELECT pi();
        pi         
-------------------
 3.141592653589793
(1 row)

SELECT degrees(1.0::float8) AS one_radian, radians(180.0::float8) AS half_turn;
    one_radian     |     half_turn     
-------------------+-------------------
 57.29577951308232 | 3.141592653589793
(1 row)

SELECT degrees(0.0::float8) AS zero, radians(0.0::float8) AS zero_r,
       degrees(-1.0::float8) AS neg;
 zero | zero_r |        neg         
------+--------+--------------------
    0 |      0 | -57.29577951308232
(1 row)

-- the conversions are total on the infinities; only the *result* can overflow
SELECT degrees('infinity'::float8), degrees('-infinity'::float8),
       radians('infinity'::float8);
 degrees  |  degrees  | radians  
----------+-----------+----------
 Infinity | -Infinity | Infinity
(1 row)

SELECT degrees('nan'::float8), radians('nan'::float8);
 degrees | radians 
---------+---------
     NaN |     NaN
(1 row)

SELECT degrees(1e308::float8);
ERROR:  value out of range: overflow
SELECT radians(1e-323::float8);
ERROR:  value out of range: underflow
-- a subnormal result is fine; only a flush to zero is an underflow
SELECT degrees(1e-310::float8), radians(1e-310::float8);
        degrees         |       radians       
------------------------+---------------------
 5.729577951308214e-309 | 1.745329251995e-312
(1 row)

--
-- sin / cos / tan / cot: the platform's libm, with no exactness correction
--
SELECT sin(0.0::float8), cos(0.0::float8), tan(0.0::float8);
 sin | cos | tan 
-----+-----+-----
   0 |   1 |   0
(1 row)

-- Away from the exact points these are libm's digits, and libm's last bit is
-- not the same on every platform (glibc and Darwin disagree on tan(1) and
-- acos(0.5)). So this checks the value to within an ulp and the identities
-- between the four, the way float8.sql checks the degree tier with `IN` rather
-- than with digits.
SELECT abs(sin(1.0::float8) - 0.8414709848078965) < 1e-15 AS sin1,
       abs(cos(1.0::float8) - 0.5403023058681398) < 1e-15 AS cos1,
       abs(tan(1.0::float8) - 1.5574077246549023) < 1e-15 AS tan1,
       abs(cot(1.0::float8) - 0.6420926159343306) < 1e-15 AS cot1;
 sin1 | cos1 | tan1 | cot1 
------+------+------+------
 t    | t    | t    | t
(1 row)

-- cot is 1/tan by construction, so this holds whatever libm rounds tan to.
-- `tan = sin/cos` is deliberately *not* asserted: glibc rounds tan correctly
-- and the naive quotient does not, so that identity is false there and true
-- on Darwin.
SELECT cot(1.0::float8) = 1.0::float8 / tan(1.0::float8) AS cot_is_one_over_tan;
 cot_is_one_over_tan 
---------------------
 t
(1 row)

-- the radian tier applies no exactness correction, which is the whole
-- difference between it and the degree tier
SELECT sind(30.0::float8) = 0.5 AS degree_tier_exact,
       sin(radians(30.0::float8)) = 0.5 AS radian_tier_exact;
 degree_tier_exact | radian_tier_exact 
-------------------+-------------------
 t                 | f
(1 row)

-- cot is 1/tan, so the denominator's signed zero picks the sign of the pole
SELECT cot(0.0::float8) AS pos_zero, cot('-0'::float8) AS neg_zero;
 pos_zero | neg_zero  
----------+-----------
 Infinity | -Infinity
(1 row)

-- no pole in float8: pi()/2 is not exactly pi/2, so tan is merely huge
SELECT tan(pi()/2) > 1e15 AS near_pole,
       tan(pi()/2) < 'infinity'::float8 AS still_finite;
 near_pole | still_finite 
-----------+--------------
 t         | t
(1 row)

-- NaN passes through; an infinite angle has no value and is an error
SELECT sin('nan'::float8), cos('nan'::float8), tan('nan'::float8),
       cot('nan'::float8);
 sin | cos | tan | cot 
-----+-----+-----+-----
 NaN | NaN | NaN | NaN
(1 row)

SELECT sin('infinity'::float8);
ERROR:  input is out of range
SELECT cos('-infinity'::float8);
ERROR:  input is out of range
SELECT tan('infinity'::float8);
ERROR:  input is out of range
SELECT cot('infinity'::float8);
ERROR:  input is out of range
--
-- asin / acos / atan / atan2
--
SELECT asin(0.0::float8), asin(1.0::float8), asin(-1.0::float8);
 asin |        asin        |        asin         
------+--------------------+---------------------
    0 | 1.5707963267948966 | -1.5707963267948966
(1 row)

SELECT acos(0.0::float8), acos(1.0::float8), acos(-1.0::float8);
        acos        | acos |       acos        
--------------------+------+-------------------
 1.5707963267948966 |    0 | 3.141592653589793
(1 row)

-- libm's digits again, so to within an ulp (see sin/cos/tan/cot above)
SELECT abs(asin(0.5::float8) - 0.5235987755982989) < 1e-15 AS asin_half,
       abs(acos(0.5::float8) - 1.0471975511965979) < 1e-15 AS acos_half;
 asin_half | acos_half 
-----------+-----------
 t         | t
(1 row)

-- outside [-1, 1] — including the infinities — is a domain error
SELECT asin(1.5::float8);
ERROR:  input is out of range
SELECT acos(-1.5::float8);
ERROR:  input is out of range
SELECT asin('infinity'::float8);
ERROR:  input is out of range
SELECT acos('-infinity'::float8);
ERROR:  input is out of range
SELECT asin('nan'::float8), acos('nan'::float8);
 asin | acos 
------+------
  NaN |  NaN
(1 row)

-- atan and atan2 are total: an infinity is a limit, not an error
SELECT atan(0.0::float8), atan(1.0::float8), atan(-1.0::float8);
 atan |        atan        |        atan         
------+--------------------+---------------------
    0 | 0.7853981633974483 | -0.7853981633974483
(1 row)

SELECT atan('infinity'::float8), atan('-infinity'::float8), atan('nan'::float8);
        atan        |        atan         | atan 
--------------------+---------------------+------
 1.5707963267948966 | -1.5707963267948966 |  NaN
(1 row)

SELECT atan2(1.0::float8, 1.0::float8), atan2(-1.0::float8, 1.0::float8),
       atan2(0.0::float8, -1.0::float8);
       atan2        |        atan2        |       atan2       
--------------------+---------------------+-------------------
 0.7853981633974483 | -0.7853981633974483 | 3.141592653589793
(1 row)

SELECT atan2('infinity'::float8, 'infinity'::float8),
       atan2('infinity'::float8, 'nan'::float8),
       atan2(1.0::float8, 'infinity'::float8);
       atan2        | atan2 | atan2 
--------------------+-------+-------
 0.7853981633974483 |   NaN |     0
(1 row)

-- an integer argument reaches float8 through the usual implicit cast
SELECT sin(0), cos(0), atan2(1, 1);
 sin | cos |       atan2        
-----+-----+--------------------
   0 |   1 | 0.7853981633974483
(1 row)

--
-- gcd / lcm: integer overloads
--
SELECT gcd(6, 4), gcd(-6, 4), gcd(6, -4), gcd(-6, -4);
 gcd | gcd | gcd | gcd 
-----+-----+-----+-----
   2 |   2 |   2 |   2
(1 row)

SELECT gcd(0, 0), gcd(0, -5), gcd(5, 0), gcd(1, 1);
 gcd | gcd | gcd | gcd 
-----+-----+-----+-----
   0 |   5 |   5 |   1
(1 row)

SELECT lcm(6, 4), lcm(-4, 6), lcm(0, 5), lcm(5, 0), lcm(0, 0);
 lcm | lcm | lcm | lcm | lcm 
-----+-----+-----+-----+-----
  12 |  12 |   0 |   0 |   0
(1 row)

SELECT gcd(1071, 462), lcm(21, 6);
 gcd | lcm 
-----+-----
  21 |  42
(1 row)

SELECT gcd(6::int8, 4::int8), pg_typeof(gcd(6::int8, 4::int8));
 gcd | pg_typeof 
-----+-----------
   2 | bigint
(1 row)

-- the overflow condition is a result the type cannot hold, so it depends on
-- the width: |int4 min| does not fit in int4, but it does fit in int8
SELECT gcd((-2147483648)::int4, 0::int4);
ERROR:  integer out of range
SELECT gcd(0::int4, (-2147483648)::int4);
ERROR:  integer out of range
SELECT gcd((-2147483648)::int4, (-2147483648)::int4);
ERROR:  integer out of range
SELECT gcd((-2147483648)::int4, 2::int4);
 gcd 
-----
   2
(1 row)

SELECT gcd((-2147483648)::int8, 0::int8);
    gcd     
------------
 2147483648
(1 row)

SELECT gcd((-9223372036854775808)::int8, 0::int8);
ERROR:  bigint out of range
-- a zero operand answers before anything is multiplied, so it never overflows
SELECT lcm((-2147483648)::int4, 0::int4);
 lcm 
-----
   0
(1 row)

SELECT lcm((-2147483648)::int4, 1::int4);
ERROR:  integer out of range
SELECT lcm(2147483647::int4, 2147483646::int4);
ERROR:  integer out of range
SELECT lcm(4611686018427387904::int8, 2::int8);
         lcm         
---------------------
 4611686018427387904
(1 row)

--
-- gcd / lcm: numeric
--
SELECT gcd(4.2::numeric, 2.8::numeric), lcm(4.2::numeric, 2.8::numeric);
 gcd | lcm 
-----+-----
 1.4 | 8.4
(1 row)

SELECT gcd(1.5::numeric, 0.5::numeric), lcm(1.5::numeric, 0.5::numeric);
 gcd | lcm 
-----+-----
 0.5 | 1.5
(1 row)

-- the display scale of both is max(scale(x), scale(y))
SELECT gcd(2.0::numeric, 4.000::numeric), lcm(2.0::numeric, 4.000::numeric);
  gcd  |  lcm  
-------+-------
 2.000 | 4.000
(1 row)

SELECT gcd(0.30::numeric, 0.2::numeric), lcm(0.30::numeric, 0.2::numeric);
 gcd  | lcm  
------+------
 0.10 | 0.60
(1 row)

SELECT gcd(0::numeric, 0.00::numeric), lcm(0::numeric, 0.00::numeric);
 gcd  | lcm  
------+------
 0.00 | 0.00
(1 row)

SELECT gcd(-4.20::numeric, 0::numeric), lcm(3::numeric, 0.5::numeric);
 gcd  | lcm 
------+-----
 4.20 | 3.0
(1 row)

SELECT gcd(1e10::numeric, 1e5::numeric);
  gcd   
--------
 100000
(1 row)

-- unlike the integer overloads, a magnitude with no finite divisor is NaN
SELECT gcd('nan'::numeric, 1), lcm('nan'::numeric, 1);
 gcd | lcm 
-----+-----
 NaN | NaN
(1 row)

SELECT gcd('infinity'::numeric, 1), lcm('infinity'::numeric, 2);
 gcd | lcm 
-----+-----
 NaN | NaN
(1 row)

SELECT gcd(0::numeric, '-infinity'::numeric), lcm('nan'::numeric, 'infinity'::numeric);
 gcd | lcm 
-----+-----
 NaN | NaN
(1 row)

-- wider than either integer type
SELECT gcd(12345678901234567890123::numeric, 123::numeric);
 gcd 
-----
   3
(1 row)

SELECT lcm(9999999999999999999999::numeric, 9999999999999999999998::numeric);
                     lcm                      
----------------------------------------------
 99999999999999999999970000000000000000000002
(1 row)

-- a numeric argument binds the numeric overload exactly; an integer one does not
SELECT pg_typeof(gcd(6, 4)), pg_typeof(gcd(6.0, 4.0)), pg_typeof(lcm(6, 4));
 pg_typeof | pg_typeof | pg_typeof 
-----------+-----------+-----------
 integer   | numeric   | integer
(1 row)

--
-- abs has one overload per numeric type, so it keeps the argument's own type
-- rather than drifting to float8, the category's preferred type
--
SELECT abs(-3::int2) AS v, pg_typeof(abs(-3::int2)) AS t;
 v |    t     
---+----------
 3 | smallint
(1 row)

SELECT abs(-3::int4) AS v, pg_typeof(abs(-3::int4)) AS t;
 v |    t    
---+---------
 3 | integer
(1 row)

SELECT abs(-3::int8) AS v, pg_typeof(abs(-3::int8)) AS t;
 v |   t    
---+--------
 3 | bigint
(1 row)

SELECT abs(-3.5::float4) AS v, pg_typeof(abs(-3.5::float4)) AS t;
  v  |  t   
-----+------
 3.5 | real
(1 row)

SELECT abs(-3.5::float8) AS v, pg_typeof(abs(-3.5::float8)) AS t;
  v  |        t         
-----+------------------
 3.5 | double precision
(1 row)

SELECT abs(-3.50::numeric) AS v, pg_typeof(abs(-3.50::numeric)) AS t;
  v   |    t    
------+---------
 3.50 | numeric
(1 row)

-- the magnitude of each type's minimum is not representable in it
SELECT abs((-32768)::int2);
ERROR:  smallint out of range
SELECT abs((-2147483648)::int4);
ERROR:  integer out of range
SELECT abs((-9223372036854775808)::int8);
ERROR:  bigint out of range
-- and the `@` prefix operator answers the same way
SELECT @ (-3::int4) AS v, pg_typeof(@ (-3::int4)) AS t;
 v |    t    
---+---------
 3 | integer
(1 row)

--
-- NULL is NULL throughout (every function here is strict)
--
SELECT sin(NULL::float8), degrees(NULL::float8), atan2(NULL::float8, 1.0::float8);
 sin | degrees | atan2 
-----+---------+-------
     |         |      
(1 row)

SELECT gcd(NULL::int4, 4), lcm(4.2::numeric, NULL::numeric);
 gcd | lcm 
-----+-----
     |    
(1 row)

