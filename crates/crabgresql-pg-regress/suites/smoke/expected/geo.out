-------------+-------------
 <(3,5),0>   | <(3,5),NaN>
(1 row)

-- circle measures and conversions
SELECT center(circle '<(5,1),3>') AS center,
       @@ circle '<(5,1),3>' AS at_at,
       radius(circle '<(5,1),3>') AS radius,
       diameter(circle '<(5,1),3>') AS diameter;
 center | at_at | radius | diameter 
--------+-------+--------+----------
