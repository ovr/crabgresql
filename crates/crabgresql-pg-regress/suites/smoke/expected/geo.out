-- the non-error-throwing input API over the new types
SELECT pg_input_is_valid('{1, 1}', 'line') AS bad_line,
       pg_input_is_valid('200', 'box') AS bad_box,
       pg_input_is_valid('<(1,2),3>', 'circle') AS ok_circle;
