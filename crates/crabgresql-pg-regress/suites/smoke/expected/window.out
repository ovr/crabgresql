--
-- WINDOW FUNCTIONS
-- PARTITION BY / ORDER BY, the ranking trio (row_number/rank/dense_rank) and
-- the standard aggregates in window mode, all over the default frame
-- (RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW). Covers peer-group
-- semantics — which is what makes a running aggregate give tied rows the same
-- value — NULL partitioning, multiple specs, the WINDOW clause, windows over a
-- grouped aggregate, and the errors PG reports for a misplaced window call.
--
-- Every query carries an explicit ORDER BY: a window query with no ORDER BY of
-- its own returns rows in the last-evaluated spec's sort order, and rows that
-- tie on every key then have no defined order to pin.
--
CREATE TABLE empsalary (depname text, empno integer, salary integer);
INSERT INTO empsalary VALUES
  ('develop', 7, 4200),
  ('develop', 9, 4500),
  ('develop', 10, 5200),
  ('develop', 11, 5200),
  ('personnel', 2, 3900),
  ('personnel', 5, 3500),
  ('sales', 1, 5000),
  ('sales', 3, 4800),
  ('sales', 4, 4800);
-- PARTITION BY alone: the aggregate is the whole partition, repeated per row
SELECT depname, empno, sum(salary) OVER (PARTITION BY depname) FROM empsalary ORDER BY depname, empno;
  depname  | empno |  sum  
-----------+-------+-------
 develop   |     7 | 19100
 develop   |     9 | 19100
 develop   |    10 | 19100
 develop   |    11 | 19100
 personnel |     2 |  7400
 personnel |     5 |  7400
 sales     |     1 | 14600
 sales     |     3 | 14600
 sales     |     4 | 14600
(9 rows)

-- ORDER BY alone: one partition, and the aggregate is a running total
SELECT empno, sum(salary) OVER (ORDER BY empno) FROM empsalary ORDER BY empno;
 empno |  sum  
-------+-------
     1 |  5000
     2 |  8900
     3 | 13700
     4 | 18500
     5 | 22000
     7 | 26200
     9 | 30700
    10 | 35900
    11 | 41100
(9 rows)

-- both
SELECT depname, empno, sum(salary) OVER (PARTITION BY depname ORDER BY empno) FROM empsalary ORDER BY depname, empno;
  depname  | empno |  sum  
-----------+-------+-------
 develop   |     7 |  4200
 develop   |     9 |  8700
 develop   |    10 | 13900
 develop   |    11 | 19100
 personnel |     2 |  3900
 personnel |     5 |  7400
 sales     |     1 |  5000
 sales     |     3 |  9800
 sales     |     4 | 14600
(9 rows)

-- the ranking trio over deliberate ties: rank skips after a tie, dense_rank
-- does not, and row_number never ties
SELECT depname, salary, rank() OVER w, dense_rank() OVER w, row_number() OVER w
  FROM empsalary WINDOW w AS (PARTITION BY depname ORDER BY salary)
  ORDER BY depname, salary, empno;
  depname  | salary | rank | dense_rank | row_number 
-----------+--------+------+------------+------------
 develop   |   4200 |    1 |          1 |          1
 develop   |   4500 |    2 |          2 |          2
 develop   |   5200 |    3 |          3 |          3
 develop   |   5200 |    3 |          3 |          4
 personnel |   3500 |    1 |          1 |          1
 personnel |   3900 |    2 |          2 |          2
 sales     |   4800 |    1 |          1 |          1
 sales     |   4800 |    1 |          1 |          2
 sales     |   5000 |    3 |          2 |          3
(9 rows)

-- THE peer-group semantic: the default RANGE frame ends at the current row's
-- LAST peer, so tied rows share a running total. `develop` has two rows at
-- 5200, and both see 19100 rather than 13900 and 19100.
SELECT depname, salary, sum(salary) OVER (PARTITION BY depname ORDER BY salary)
  FROM empsalary ORDER BY depname, salary, empno;
  depname  | salary |  sum  
-----------+--------+-------
 develop   |   4200 |  4200
 develop   |   4500 |  8700
 develop   |   5200 | 19100
 develop   |   5200 | 19100
 personnel |   3500 |  3500
 personnel |   3900 |  7400
 sales     |   4800 |  9600
 sales     |   4800 |  9600
 sales     |   5000 | 14600
(9 rows)

-- with no ORDER BY every row is a peer of every other, so rank() is 1
-- everywhere and the aggregate is the partition total
SELECT depname, rank() OVER (PARTITION BY depname), count(*) OVER (PARTITION BY depname)
  FROM empsalary ORDER BY depname, empno;
  depname  | rank | count 
-----------+------+-------
 develop   |    1 |     4
 develop   |    1 |     4
 develop   |    1 |     4
 develop   |    1 |     4
 personnel |    1 |     2
 personnel |    1 |     2
 sales     |    1 |     3
 sales     |    1 |     3
 sales     |    1 |     3
(9 rows)

-- min/max/avg/string_agg in window mode
SELECT empno, min(salary) OVER w, max(salary) OVER w, avg(salary) OVER w
  FROM empsalary WINDOW w AS (ORDER BY empno) ORDER BY empno;
 empno | min  | max  |          avg          
-------+------+------+-----------------------
     1 | 5000 | 5000 | 5000.0000000000000000
     2 | 3900 | 5000 | 4450.0000000000000000
     3 | 3900 | 5000 | 4566.6666666666666667
     4 | 3900 | 5000 | 4625.0000000000000000
     5 | 3500 | 5000 | 4400.0000000000000000
     7 | 3500 | 5000 | 4366.6666666666666667
     9 | 3500 | 5000 | 4385.7142857142857143
    10 | 3500 | 5200 | 4487.5000000000000000
    11 | 3500 | 5200 | 4566.6666666666666667
(9 rows)

SELECT empno, string_agg(depname, ',') OVER (ORDER BY empno) FROM empsalary ORDER BY empno;
 empno |                              string_agg                               
-------+-----------------------------------------------------------------------
     1 | sales
     2 | sales,personnel
     3 | sales,personnel,sales
     4 | sales,personnel,sales,sales
     5 | sales,personnel,sales,sales,personnel
     7 | sales,personnel,sales,sales,personnel,develop
     9 | sales,personnel,sales,sales,personnel,develop,develop
    10 | sales,personnel,sales,sales,personnel,develop,develop,develop
    11 | sales,personnel,sales,sales,personnel,develop,develop,develop,develop
(9 rows)

-- two specs in one query
SELECT empno, rank() OVER (ORDER BY salary), sum(salary) OVER (PARTITION BY depname)
  FROM empsalary ORDER BY empno;
 empno | rank |  sum  
-------+------+-------
     1 |    7 | 14600
     2 |    2 |  7400
     3 |    5 | 14600
     4 |    5 | 14600
     5 |    1 |  7400
     7 |    3 | 19100
     9 |    4 | 19100
    10 |    8 | 19100
    11 |    8 | 19100
(9 rows)

-- two named windows with identical bodies collapse to one step
SELECT empno, rank() OVER w1, sum(salary) OVER w2
  FROM empsalary WINDOW w1 AS (ORDER BY empno), w2 AS (ORDER BY empno)
  ORDER BY empno;
 empno | rank |  sum  
-------+------+-------
     1 |    1 |  5000
     2 |    2 |  8900
     3 |    3 | 13700
     4 |    4 | 18500
     5 |    5 | 22000
     7 |    6 | 26200
     9 |    7 | 30700
    10 |    8 | 35900
    11 |    9 | 41100
(9 rows)

-- OVER w with an inline ORDER BY added to a base that has none
SELECT empno, rank() OVER (w ORDER BY salary)
  FROM empsalary WINDOW w AS (PARTITION BY depname) ORDER BY depname, salary, empno;
 empno | rank 
-------+------
     7 |    1
     9 |    2
    10 |    3
    11 |    3
     5 |    1
     2 |    2
     3 |    1
     4 |    1
     1 |    3
(9 rows)

-- a window over a grouped aggregate: the inner sum is per group, the outer one
-- runs over the groups
SELECT depname, sum(salary), sum(sum(salary)) OVER (ORDER BY depname)
  FROM empsalary GROUP BY depname ORDER BY depname;
  depname  |  sum  |  sum  
-----------+-------+-------
 develop   | 19100 | 19100
 personnel |  7400 | 26500
 sales     | 14600 | 41100
(3 rows)

-- a window in ORDER BY, which rides a hidden column
SELECT empno FROM empsalary ORDER BY rank() OVER (ORDER BY salary), empno;
 empno 
-------
     5
     2
     7
     9
     3
     4
     1
    10
    11
(9 rows)

-- the default frame written out longhand means the same thing
SELECT empno, sum(salary) OVER (ORDER BY empno RANGE UNBOUNDED PRECEDING) FROM empsalary ORDER BY empno;
 empno |  sum  
-------+-------
     1 |  5000
     2 |  8900
     3 | 13700
     4 | 18500
     5 | 22000
     7 | 26200
     9 | 30700
    10 | 35900
    11 | 41100
(9 rows)

-- NULLs: a NULL partition key groups with the other NULLs, and NULLs in the
-- window ORDER BY are their own peer group, placed per the direction's default
CREATE TABLE wnull (k integer, v integer);
INSERT INTO wnull VALUES (NULL, 1), (NULL, 2), (1, 4), (1, 8);
SELECT k, v, count(*) OVER (PARTITION BY k) FROM wnull ORDER BY k NULLS FIRST, v;
 k | v | count 
---+---+-------
   | 1 |     2
   | 2 |     2
 1 | 4 |     2
 1 | 8 |     2
(4 rows)

SELECT k, v, rank() OVER (ORDER BY k), sum(v) OVER (ORDER BY k) FROM wnull ORDER BY k NULLS FIRST, v;
 k | v | rank | sum 
---+---+------+-----
   | 1 |    3 |  15
   | 2 |    3 |  15
 1 | 4 |    1 |  12
 1 | 8 |    1 |  12
(4 rows)

SELECT k, v, rank() OVER (ORDER BY k DESC) FROM wnull ORDER BY k NULLS FIRST, v;
 k | v | rank 
---+---+------
   | 1 |    1
   | 2 |    1
 1 | 4 |    3
 1 | 8 |    3
(4 rows)

-- a single-row partition, and an empty table
SELECT k, rank() OVER (PARTITION BY v ORDER BY k) FROM wnull ORDER BY v;
 k | rank 
---+------
   |    1
   |    1
 1 |    1
 1 |    1
(4 rows)

CREATE TABLE wempty (a integer);
SELECT a, rank() OVER (ORDER BY a), count(*) OVER () FROM wempty ORDER BY a;
 a | rank | count 
---+------+-------
(0 rows)

-- a FROM-less window runs over the one virtual row
SELECT row_number() OVER (), rank() OVER (ORDER BY 1);
 row_number | rank 
------------+------
          1 |    1
(1 row)

-- WHERE runs before windows do, so it filters the rows the window sees
SELECT empno, count(*) OVER () FROM empsalary WHERE salary > 4500 ORDER BY empno;
 empno | count 
-------+-------
     1 |     5
     3 |     5
     4 |     5
    10 |     5
    11 |     5
(5 rows)

-- a window with LIMIT: the limit applies after the window and its sort
SELECT empno, rank() OVER (ORDER BY salary DESC) FROM empsalary ORDER BY 2, empno LIMIT 3;
 empno | rank 
-------+------
    10 |    1
    11 |    1
     1 |    3
(3 rows)

-- DISTINCT applies to the window's output
SELECT DISTINCT sum(salary) OVER (PARTITION BY depname) FROM empsalary ORDER BY 1;
  sum  
-------
  7400
 14600
 19100
(3 rows)

-- errors: every clause evaluated before windows are
SELECT 1 FROM empsalary WHERE rank() OVER () > 1;
ERROR:  window functions are not allowed in WHERE
SELECT depname FROM empsalary GROUP BY depname HAVING rank() OVER () > 1;
ERROR:  window functions are not allowed in HAVING
SELECT depname FROM empsalary GROUP BY depname, rank() OVER ();
ERROR:  window functions are not allowed in GROUP BY
SELECT rank() OVER (PARTITION BY rank() OVER ()) FROM empsalary;
ERROR:  window functions are not allowed in window definitions
-- errors: nesting, and an aggregate over a window
SELECT sum(rank() OVER ()) OVER () FROM empsalary;
ERROR:  window function calls cannot be nested
SELECT sum(sum(salary) OVER ()) FROM empsalary;
ERROR:  aggregate function calls cannot contain window function calls
-- errors: forms PG does not implement
SELECT sum(DISTINCT salary) OVER () FROM empsalary;
ERROR:  DISTINCT is not implemented for window functions
-- errors: a window function needs an OVER clause, and OVER needs a window
-- function or an aggregate
SELECT rank() FROM empsalary;
ERROR:  window function rank requires an OVER clause
SELECT abs(salary) OVER () FROM empsalary;
ERROR:  OVER specified, but abs is not a window function nor an aggregate function
-- errors: the WINDOW clause's copy rules
SELECT rank() OVER w FROM empsalary;
ERROR:  window "w" does not exist
SELECT rank() OVER (w PARTITION BY depname) FROM empsalary WINDOW w AS (ORDER BY salary);
ERROR:  cannot override PARTITION BY clause of window "w"
SELECT rank() OVER (w ORDER BY empno) FROM empsalary WINDOW w AS (ORDER BY salary);
ERROR:  cannot override ORDER BY clause of window "w"
SELECT rank() OVER (w) FROM empsalary WINDOW w AS (ORDER BY salary ROWS UNBOUNDED PRECEDING);
ERROR:  cannot copy window "w" because it has a frame clause
HINT:  Omit the parentheses in this OVER clause.
SELECT rank() OVER () FROM empsalary WINDOW w AS (ORDER BY salary), w AS (ORDER BY empno);
ERROR:  window "w" is already defined
-- but `OVER w` is a reference, not a copy: it inherits the base's frame rather
-- than being refused for having one, so it reaches the unimplemented frame path
SELECT rank() OVER w FROM empsalary WINDOW w AS (ORDER BY salary ROWS UNBOUNDED PRECEDING);
ERROR:  explicit window frames are not supported yet
-- a WINDOW definition may name a *prior* one, and the copy inherits what the
-- base contributes — so w2 ranks within each depname
SELECT depname, empno, rank() OVER w2
  FROM empsalary WINDOW w1 AS (PARTITION BY depname), w2 AS (w1 ORDER BY empno)
  ORDER BY depname, empno;
  depname  | empno | rank 
-----------+-------+------
 develop   |     7 |    1
 develop   |     9 |    2
 develop   |    10 |    3
 develop   |    11 |    4
 personnel |     2 |    1
 personnel |     5 |    2
 sales     |     1 |    1
 sales     |     3 |    2
 sales     |     4 |    3
(9 rows)

-- and `OVER (w2)` copies the *expanded* w2, not its unexpanded body
SELECT depname, empno, rank() OVER (w2)
  FROM empsalary WINDOW w1 AS (PARTITION BY depname), w2 AS (w1 ORDER BY empno)
  ORDER BY depname, empno;
  depname  | empno | rank 
-----------+-------+------
 develop   |     7 |    1
 develop   |     9 |    2
 develop   |    10 |    3
 develop   |    11 |    4
 personnel |     2 |    1
 personnel |     5 |    2
 sales     |     1 |    1
 sales     |     3 |    2
 sales     |     4 |    3
(9 rows)

-- the clause resolves left to right, so a self or forward reference names a
-- window that does not exist yet, and the copy rules apply between definitions
SELECT 1 FROM empsalary WINDOW w AS (w);
ERROR:  window "w" does not exist
SELECT rank() OVER w2 FROM empsalary WINDOW w2 AS (w1 ORDER BY empno), w1 AS (PARTITION BY depname);
ERROR:  window "w1" does not exist
SELECT 1 FROM empsalary WINDOW w1 AS (ORDER BY empno ROWS UNBOUNDED PRECEDING), w2 AS (w1);
ERROR:  cannot copy window "w1" because it has a frame clause
SELECT 1 FROM empsalary WINDOW w1 AS (ORDER BY empno), w2 AS (w1 ORDER BY salary);
ERROR:  cannot override ORDER BY clause of window "w1"
-- three specs: PG orders the chain so a shorter key list follows the longer one
-- it is a prefix of, sharing that sort; the last one evaluated decides row order
SELECT empno, rank() OVER (ORDER BY empno) p, rank() OVER (ORDER BY empno, salary) q,
       rank() OVER (ORDER BY salary) r
  FROM empsalary ORDER BY empno;
 empno | p | q | r 
-------+---+---+---
     1 | 1 | 1 | 7
     2 | 2 | 2 | 2
     3 | 3 | 3 | 5
     4 | 4 | 4 | 5
     5 | 5 | 5 | 1
     7 | 6 | 6 | 3
     9 | 7 | 7 | 4
    10 | 8 | 8 | 8
    11 | 9 | 9 | 8
(9 rows)

-- errors: every remaining clause evaluated before windows are
SELECT e.empno FROM empsalary e LEFT JOIN empsalary f ON rank() OVER () > 0;
ERROR:  window functions are not allowed in JOIN conditions
SELECT empno FROM empsalary LIMIT rank() OVER ();
ERROR:  window functions are not allowed in LIMIT
SELECT empno FROM empsalary OFFSET rank() OVER ();
ERROR:  window functions are not allowed in OFFSET
VALUES (rank() OVER ());
ERROR:  window functions are not allowed in VALUES
UPDATE empsalary SET empno = rank() OVER ();
ERROR:  window functions are not allowed in UPDATE
UPDATE empsalary SET empno = empno WHERE rank() OVER () > 0;
ERROR:  window functions are not allowed in WHERE
DELETE FROM empsalary WHERE rank() OVER () > 0;
ERROR:  window functions are not allowed in WHERE
UPDATE empsalary SET empno = empno RETURNING rank() OVER ();
ERROR:  window functions are not allowed in RETURNING
-- the same clauses reject a misplaced aggregate, and PG blames whichever of the
-- two is written first
UPDATE empsalary SET empno = count(*);
ERROR:  aggregate functions are not allowed in UPDATE
SELECT empno FROM empsalary LIMIT count(*);
ERROR:  aggregate functions are not allowed in LIMIT
SELECT 1 FROM empsalary WHERE count(*) > 0 AND rank() OVER () > 0;
ERROR:  aggregate functions are not allowed in WHERE
SELECT 1 FROM empsalary WHERE rank() OVER () > 0 AND count(*) > 0;
ERROR:  window functions are not allowed in WHERE
-- `TABLE t` is `SELECT * FROM t`, so its ORDER BY may hold a window call
CREATE TABLE wsmall (a integer);
INSERT INTO wsmall VALUES (3), (1), (2);
TABLE wsmall ORDER BY rank() OVER (ORDER BY a DESC);
 a 
---
 3
 2
 1
(3 rows)

DROP TABLE wsmall;
-- errors: explicit frames are not implemented yet
SELECT sum(salary) OVER (ORDER BY empno ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM empsalary;
ERROR:  explicit window frames are not supported yet
SELECT sum(salary) OVER (ORDER BY empno RANGE UNBOUNDED PRECEDING EXCLUDE TIES) FROM empsalary;
ERROR:  explicit window frames are not supported yet
DROP TABLE empsalary;
DROP TABLE wnull;
DROP TABLE wempty;
